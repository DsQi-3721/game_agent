# Copy to .env and fill in the keys you use. Loaded by arena.llm.model_registry.
# .env is git-ignored; never commit real keys.

DEEPSEEK_API_KEY=sk-...
# VLLM_API_KEY=EMPTY
# OPENAI_API_KEY=sk-...
# GEMINI_API_KEY=...

# TypeSafe System One API (Jev): https://console.typesafe.ai/keys
TYPESAFE_API_KEY=
# Optional: point the same client at a TypeSafe-compatible server (e.g. a local kev server)
# TYPESAFE_BASE_URL=https://api.typesafe.ai
